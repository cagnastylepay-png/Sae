local request = game:GetService("ReplicatedStorage")
    .ContentCreatorRemotes.Request

local ok, result = pcall(function()
    return request:InvokeServer("spawnEgg", {
        asset = "Kitsune",
        zone = "Cherry Blossom",
        size = 50,
        randomSize = false,
    })
end)

if ok then
    if type(result) == "table" then
        print("Succès :", result.Ok)
        print("Message :", result.Message)
    
        for key, value in pairs(result) do
            print(key, value)
        end
    else
        print("Réponse :", result)
    end
else
    warn("Erreur :", result)
end
