-- VIP audit client: API Roblox standard, aucun hook/exécuteur requis.
-- À utiliser uniquement dans votre copie privée, avec un profil de test.
-- Les opérations confirmées peuvent modifier et sauvegarder votre inventaire.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
assert(player, "Exécuter côté client")
local network = RS:WaitForChild("Packages", 5)
network = network and network:WaitForChild("Networking", 5)
assert(network, "Packages.Networking introuvable : mauvaise version du jeu")
local pg = player:WaitForChild("PlayerGui")
local old = pg:FindFirstChild("VIPAuditClient")
if old then old:Destroy() end
local gui = Instance.new("ScreenGui")
gui.Name = "VIPAuditClient"; gui.ResetOnSpawn = false; gui.Parent = pg
local panel = Instance.new("ScrollingFrame")
panel.Size = UDim2.new(0, 460, 0.85, 0); panel.Position = UDim2.fromOffset(15, 40)
panel.BackgroundColor3 = Color3.fromRGB(25, 28, 36); panel.BorderSizePixel = 0
panel.AutomaticCanvasSize = Enum.AutomaticSize.Y; panel.CanvasSize = UDim2.new()
panel.ScrollBarThickness = 6; panel.Parent = gui
local layout = Instance.new("UIListLayout"); layout.Padding = UDim.new(0, 7); layout.Parent = panel
local padding = Instance.new("UIPadding"); padding.PaddingLeft = UDim.new(0, 10)
padding.PaddingRight = UDim.new(0, 10); padding.PaddingTop = UDim.new(0, 10); padding.Parent = panel
local function label(text, height)
 local x = Instance.new("TextLabel"); x.Size = UDim2.new(1, -8, 0, height or 40)
 x.BackgroundTransparency = 1; x.TextColor3 = Color3.new(1,1,1)
 x.TextWrapped = true; x.TextSize = 15; x.Font = Enum.Font.Code; x.Text = text; x.Parent = panel
 return x
end
label("VIP • Audit client — compte de test", 30)
label("Un appel à la fois. Double-clic de confirmation pour les mutations. Aucun test ne prouve une faille à lui seul.", 55)
local function input(placeholder, initial)
 local x = Instance.new("TextBox"); x.Size = UDim2.new(1, -8, 0, 36)
 x.BackgroundColor3 = Color3.fromRGB(43,48,60); x.TextColor3 = Color3.new(1,1,1)
 x.TextSize = 14; x.ClearTextOnFocus = false; x.PlaceholderText = placeholder; x.Text = initial or ""; x.Parent = panel
 return x
end
local uid = input("UID œuf de test")
local output = label("Prêt. Commence par lire les œufs du monde.", 155)
output.TextXAlignment = Enum.TextXAlignment.Left; output.TextYAlignment = Enum.TextYAlignment.Top
local function format(v, depth)
 depth = depth or 0
 if type(v) ~= "table" then return tostring(v) end
 if depth > 2 then return "{…}" end
 local parts = {}; local n = 0
 for k, item in pairs(v) do
  n += 1; if n > 12 then table.insert(parts, "…"); break end
  table.insert(parts, tostring(k).."="..format(item, depth+1))
 end
 return "{"..table.concat(parts, ", ").."}"
end
local function log(s) output.Text = string.sub(s,1,2200); print("[VIP AUDIT]",s) end
local busy, closed = false, false
local function remote(scope, name, class)
 local r = network:FindFirstChild((class == "RemoteEvent" and "RE/" or "RF/")..scope.."/"..name)
 assert(r and r:IsA(class or "RemoteFunction"), "Remote absent : "..scope.."/"..name)
 return r
end
local function invoke(scope, name, ...)
 local result = table.pack(remote(scope,name):InvokeServer(...))
 log(scope.."/"..name.."\n"..format(result))
 return table.unpack(result,1,result.n)
end
local function selected()
 local value = uid.Text:match("^%s*(.-)%s*$")
 assert(value ~= "", "Choisir ou saisir un UID de test")
 return value
end
local function button(title, mutate, callback)
 local b = Instance.new("TextButton"); b.Size = UDim2.new(1,-8,0,38)
 b.Text = title; b.TextColor3 = Color3.new(1,1,1); b.TextSize = 14
 b.BackgroundColor3 = mutate and Color3.fromRGB(115,61,42) or Color3.fromRGB(39,79,117); b.Parent = panel
 local armed = 0
 b.Activated:Connect(function()
  if busy then log("Appel précédent encore en cours ; aucun nouvel appel envoyé."); return end
  if mutate and os.clock() > armed then
   armed = os.clock()+5; b.Text = "CONFIRMER : "..title
   task.delay(5,function() if b.Parent and os.clock() >= armed then b.Text = title end end)
   return
  end
  armed = 0; b.Text = title; busy = true
  local finished = false
  task.delay(10,function()
   if not finished and not closed then log("Toujours en attente du serveur. Aucun nouvel appel automatique. Ne pas relancer un test dont le résultat est inconnu.") end
  end)
  task.spawn(function()
   local ok, err = pcall(callback)
   finished = true; busy = false
   if not ok and not closed then log("ERREUR : "..tostring(err)) end
  end)
 end)
end
local candidates, index = {}, 0
button("1. Lire les œufs du monde",false,function()
 local snapshot = invoke("EggWorld","AskFieldEggSnapshot")
 candidates = {}; index = 0
 for _, record in pairs(type(snapshot)=="table" and snapshot.Records or {}) do
  if type(record)=="table" and record.CarrierUserId == nil then table.insert(candidates,record) end
 end
 table.sort(candidates,function(a,b) return tostring(a.Uid)<tostring(b.Uid) end)
 log("Œufs sans porteur : "..#candidates..". Utilise le bouton suivant pour choisir ; rien n'est récupéré automatiquement.")
end)
button("2. Sélectionner l'œuf suivant (lecture)",false,function()
 assert(#candidates>0,"Lire d'abord les œufs du monde")
 index = index % #candidates + 1
 local r = candidates[index]; uid.Text = tostring(r.Uid)
 local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
 local distance = root and typeof(r.BottomCFrame)=="CFrame" and (root.Position-r.BottomCFrame.Position).Magnitude
 log(format({Uid=r.Uid,Category=r.AssetCategory,Area=r.AreaId,State=r.State,Distance=distance and math.floor(distance)}))
end)
button("Lire mes œufs possédés",false,function() invoke("EggWorld","AskLiveSnapshot") end)
button("TEST • Porter l'œuf sélectionné",true,function() invoke("EggWorld","AskFieldEggCarry",{Uid=selected()}) end)
button("TEST • Équiper l'œuf sélectionné",true,function() invoke("EggWorld","AskWearTool",selected()) end)
label("Pour la plantation : saisis un placement LOCAL valide de ta parcelle. 0,0,0 n'est pas garanti valide.",45)
local xyz = input("X,Y,Z local à la parcelle", "0,0,0")
button("TEST • Planter l'œuf sélectionné",true,function()
 local a,b,c = xyz.Text:match("^%s*([%d%.%-]+)%s*,%s*([%d%.%-]+)%s*,%s*([%d%.%-]+)%s*$")
 a,b,c=tonumber(a),tonumber(b),tonumber(c)
 assert(a and b and c and math.abs(a)<10000 and math.abs(b)<10000 and math.abs(c)<10000,"Coordonnées invalides")
 invoke("EggWorld","AskPlaceEgg",{Uid=selected(),LocalCFrame=CFrame.new(a,b,c)})
end)
button("TEST • Accélérer mon œuf planté",true,function() invoke("EggWorld","AskSkipGrowth",selected()) end)
button("TEST • Éclore mon œuf planté",true,function() invoke("EggWorld","AskHatch",selected()) end)
button("Relâcher l'œuf porté",true,function() invoke("EggWorld","AskFieldEggDrop",{}) end)
button("Déséquiper mon outil",true,function() invoke("EggWorld","AskDoffTool") end)
label("Compare l'inventaire et l'état côté serveur après chaque test. Une réponse true ne prouve ni sauvegarde durable, ni accès à un œuf inexistant.",65)
button("Fermer le GUI",false,function() closed=true; gui:Destroy() end)
